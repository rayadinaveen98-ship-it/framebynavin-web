# Canonical production URL. Leave unset in preview builds to use Vercel's deployment URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Private server-only endpoint that accepts the validated project brief JSON payload.
# This can later point to an email relay, automation workflow, or serverless function.
CONTACT_WEBHOOK_URL=

# Optional Bearer token sent only from the server to CONTACT_WEBHOOK_URL.
CONTACT_WEBHOOK_TOKEN=
